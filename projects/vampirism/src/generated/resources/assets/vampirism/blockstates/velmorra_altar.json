{
  "multipart": [
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar"
      },
      "when": {
        "has_blood": "false"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altarbloody"
      },
      "when": {
        "has_blood": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_seeking"
      },
      "when": {
        "channeling": "false",
        "open": "false",
        "seeking_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_seeking_glowing"
      },
      "when": {
        "channeling": "true",
        "seeking_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_seeking_inserted"
      },
      "when": {
        "channeling": "false",
        "open": "true",
        "seeking_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_passage",
        "y": 90
      },
      "when": {
        "channeling": "false",
        "open": "false",
        "passage_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_passage_glowing",
        "y": 90
      },
      "when": {
        "channeling": "true",
        "passage_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_passage_inserted",
        "y": 90
      },
      "when": {
        "channeling": "false",
        "open": "true",
        "passage_knife": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_anchoring",
        "y": 270
      },
      "when": {
        "anchoring_knife": "true",
        "channeling": "false",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_anchoring_glowing",
        "y": 270
      },
      "when": {
        "anchoring_knife": "true",
        "channeling": "true"
      }
    },
    {
      "apply": {
        "model": "vampirism:block/velmorra_altar_knife_anchoring_inserted",
        "y": 270
      },
      "when": {
        "anchoring_knife": "true",
        "channeling": "false",
        "open": "true"
      }
    }
  ]
}